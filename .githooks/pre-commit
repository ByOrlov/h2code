#!/usr/bin/env bash
# Pre-commit hook: format staged Crystal files with `crystal tool format`.
# Reformats and re-stages the files, so the commit stays clean.

set -euo pipefail

staged=()
while IFS= read -r f; do
  case "$f" in
    *.cr) staged+=("$f") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ ${#staged[@]} -eq 0 ]; then
  exit 0
fi

if ! command -v crystal >/dev/null 2>&1; then
  echo "pre-commit: crystal not found, skipping formatter" >&2
  exit 0
fi

# Reformat the staged Crystal files in place.
crystal tool format "${staged[@]}"

# Re-stage anything the formatter changed.
if ! git diff --quiet -- "${staged[@]}"; then
  git add -- "${staged[@]}"
  echo "pre-commit: reformatted and re-staged Crystal files"
fi

# Run ameba linter on the staged Crystal files.
if [ -x "bin/ameba" ]; then
  bin/ameba "${staged[@]}"
fi

# Run the test suite. Git invokes hooks with GIT_DIR / GIT_INDEX_FILE (and
# friends) set for THIS repository; inherited by every git subprocess the
# specs spawn, they override repo discovery (`git -C <tmp-repo> ...` would
# resolve against the h2code checkout instead), so they are unset first.
if command -v rake >/dev/null 2>&1; then
  unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_PREFIX
  rake spec
else
  echo "pre-commit: rake not found, skipping tests" >&2
fi

{% skip_file if flag?(:win32) %}

module TgBot
  # POSIX adapter: installs a systemd *user* unit — the daemon needs no
  # root and lives under the user's systemd manager
  # (`~/.config/systemd/user/h2code-tg-bot.service`). On POSIX systems
  # without systemd (macOS/launchd, BSD rc, …) installation refuses with a
  # clear error instead of writing a unit nothing will ever run.
  class UnixServicePort < ServicePort
    SERVICE = "h2code-tg-bot"

    def install(binary_path : String, io : IO) : Nil
      unless systemd?
        raise Error.new(
          "systemd not found — --install-service supports Linux with systemd; " +
          "on this platform register the daemon with your service manager manually")
      end
      path = unit_path
      Dir.mkdir_p(File.dirname(path))
      File.write(path, unit(binary_path))
      io.puts "installed: #{path}"
      run_systemctl(["--user", "daemon-reload"], io)
      io.puts
      io.puts "start now and on login:  systemctl --user enable --now #{SERVICE}"
      io.puts "logs:                    journalctl --user -u #{SERVICE} -f"
      io.puts "headless server (user manager at boot):"
      io.puts "  sudo loginctl enable-linger $USER"
    end

    # Where the user unit lands (XDG_CONFIG_HOME honoured; specs override
    # it to avoid touching the real ~/.config).
    def unit_path : String
      config = ENV["XDG_CONFIG_HOME"]? || File.join(ENV["HOME"]? || Dir.current, ".config")
      File.join(config, "systemd", "user", "#{SERVICE}.service")
    end

    # The unit body — pure, so specs can assert on it without systemd.
    # KillMode=process: stopping/restarting the daemon must not kill the
    # `h2code --resident` children — sessions keep running and are
    # re-adopted when the daemon comes back (same lesson as claude-tg-bot,
    # where the default cgroup kill took tmux down with all sessions).
    def unit(binary_path : String) : String
      <<-UNIT
      # #{SERVICE} — generated by `#{SERVICE} --install-service`
      [Unit]
      Description=h2code Telegram bot daemon
      Wants=network-online.target
      After=network-online.target

      [Service]
      ExecStart=#{binary_path}
      Restart=always
      RestartSec=5
      KillMode=process
      Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

      [Install]
      WantedBy=default.target
      UNIT
    end

    private def systemd? : Bool
      Process.run("systemctl", ["--version"],
        output: Process::Redirect::Close, error: Process::Redirect::Close)
      true
    rescue ex : File::NotFoundError | File::AccessDeniedError
      false
    end

    private def run_systemctl(args : Array(String), io : IO) : Nil
      status = Process.run("systemctl", args, output: io, error: io)
      unless status.success?
        raise Error.new("systemctl #{args.join(' ')} failed (exit #{status.exit_code})")
      end
    end
  end
end
